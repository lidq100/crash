+	MEMBER_OFFSET_INIT(irq_domain_mapcount, "irq_domain", "mapcount");
+	MEMBER_OFFSET_INIT(irq_domain_fwnode, "irq_domain", "fwnode");
+	MEMBER_OFFSET_INIT(irq_domain_bus_token, "irq_domain", "bus_token");
+	MEMBER_OFFSET_INIT(irq_domain_gc, "irq_domain", "gc");
+	MEMBER_OFFSET_INIT(irq_domain_parent, "irq_domain", "parent");
+	MEMBER_OFFSET_INIT(irq_domain_hwirq_max, "irq_domain", "hwirq_max");
+	MEMBER_OFFSET_INIT(irq_domain_revmap_size, "irq_domain", "revmap_size");
+	MEMBER_OFFSET_INIT(irq_domain_revmap_tree, "irq_domain", "revmap_tree");
